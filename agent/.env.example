# ShieldGuard local agent configuration (copy to agent/.env and edit).
# Everything below is OPTIONAL — sensible defaults are built in.

# --- Server ---
# Port the agent listens on (always binds 127.0.0.1 only).
SHIELDGUARD_PORT=8787

# Where events/baselines/backups/quarantine live. Default: ./data next to the agent.
#SHIELDGUARD_DATA_DIR=C:\Users\you\AppData\Local\ShieldGuard

# Extra CORS origins allowed to talk to the agent (comma separated).
# localhost dashboards and *.vercel.app are always allowed.
#SHIELDGUARD_CORS_ORIGINS=https://my-dashboard.example.com

# Extra directories to scan for persistence entries (comma separated).
#SHIELDGUARD_EXTRA_STARTUP_DIRS=

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
SHIELDGUARD_LOG_LEVEL=INFO
