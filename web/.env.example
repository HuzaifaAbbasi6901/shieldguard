# ShieldGuard web dashboard configuration (copy to web/.env.local and edit).
# Everything is OPTIONAL — without it the dashboard runs in Demo Mode and
# auto-detects a local agent at http://127.0.0.1:8787.

# Base URL of your local ShieldGuard agent (used by the BROWSER, not the server).
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:8787
